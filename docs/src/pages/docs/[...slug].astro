---
import '@/styles/docs.css';

import DocsCodeBlock from '@/components/docs/DocsCodeBlock.astro';
import { DocsRoot } from '@/components/docs/DocsRoot.tsx';
import Layout from '@/components/common/Layout.astro';
import { ReferenceTree } from '@/components/reference/ReferenceTree.tsx';
import { type DocEntry, source } from '@/content.source.ts';
import { referenceToc } from '@/reference/reference.toc.ts';
import { render } from 'astro:content';
import type { TOCItemType } from 'fumadocs-core/toc';
import defaultMdxComponents from 'fumadocs-ui/mdx';

interface Props {
  entry: DocEntry;
}

export function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join('/') : undefined },
    props: { entry: page.data._raw }
  }));
}

const { entry } = Astro.props;

/** A reference page is drawn from its schema tree; every other page is its rendered markdown. */
const { Content, reference, toc } =
  entry.collection === 'reference'
    ? { Content: undefined, reference: entry.data.reference, toc: referenceToc(entry.data.reference) }
    : await render(entry).then(({ Content, headings }) => ({
        Content,
        reference: undefined,
        toc: headings.map((heading): TOCItemType => ({
          depth: heading.depth,
          title: heading.text,
          url: `#${heading.slug}`
        }))
      }));

const slugs = typeof Astro.params.slug === 'string' ? Astro.params.slug.split('/') : [];
---

<Layout description={entry.data.description} image={`/api/opengraph/${slugs.join('/')}.webp`} title={entry.data.title}>
  <DocsRoot client:load page={{ toc }} params={Astro.params} pathname={Astro.url.pathname} tree={source.getPageTree()}>
    <aside class="border-fd-border bg-fd-card text-fd-muted-foreground mb-8 rounded-lg border px-4 py-3 text-sm">
      Collegium is currently in a very early beta stage. While some functionality is already available, the project is
      still undergoing rapid iteration and development. Future releases will change the configuration schema, plugin
      architecture, or other core behavior without notice or backward-compatibility guarantees. We do not recommend
      using Collegium in production environments at this time.
    </aside>
    <h1 class="text-3xl font-semibold">{entry.data.title}</h1>
    <p class="text-fd-muted-foreground mb-8 text-lg">{entry.data.description}</p>
    <div class="prose flex-1">
      {Content ? <Content components={{ ...defaultMdxComponents, pre: DocsCodeBlock }} /> : null}
      {reference ? <ReferenceTree client:load page={reference} /> : null}
    </div>
  </DocsRoot>
</Layout>
