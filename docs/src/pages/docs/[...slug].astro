---
import { Docs } from '@/components/docs';
import Layout from '@/components/layout.astro';
import { type DocEntry, getPageImageUrl, source } from '@/lib/source';
import { render } from 'astro:content';
import type { TOCItemType } from 'fumadocs-core/toc';
import defaultMdxComponents from 'fumadocs-ui/mdx';

interface Props {
  entry: DocEntry;
}

export function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join('/') : undefined },
    props: { entry: page.data._raw }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const slugs = typeof Astro.params.slug === 'string' ? Astro.params.slug.split('/') : [];
const page = source.getPage(slugs)!;

const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: `#${heading.slug}`
}));
---

<Layout description={entry.data.description} image={getPageImageUrl(page)} title={entry.data.title}>
  <Docs client:load page={{ toc }} params={Astro.params} pathname={Astro.url.pathname} tree={source.getPageTree()}>
    <h1 class="text-3xl font-semibold">{entry.data.title}</h1>
    {entry.data.description && <p class="text-fd-muted-foreground mb-8 text-lg">{entry.data.description}</p>}
    <div class="prose flex-1">
      <Content components={defaultMdxComponents} />
    </div>
  </Docs>
</Layout>
