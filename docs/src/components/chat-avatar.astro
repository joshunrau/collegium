---
import type { ImageMetadata } from 'astro';

import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
}

const { image } = Astro.props;
---

<Image
  alt=""
  class="size-8 shrink-0 rounded-md object-cover"
  densities={[1, 2, 3]}
  height={32}
  loading="lazy"
  quality={90}
  src={image}
  width={32}
/>
