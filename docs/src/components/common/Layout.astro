---
import { ClientRouter } from 'astro:transitions';
import { cn } from '@/utils/cn.ts';

interface Props {
  class?: string;
  description: string;
  /** Site-root-relative path to the OpenGraph image, if the page has one. */
  image?: string;
  title: string;
}

const { class: className, description, image, title } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href={canonical} rel="canonical" />
    <title>{title}</title>
    <meta content={title} name="title" />
    <meta content={title} property="og:title" />
    <meta content={canonical} property="og:url" />
    <meta content="website" property="og:type" />
    <meta content={description} name="description" />
    <meta content={description} property="og:description" />
    {image && <meta content={new URL(image, Astro.site)} property="og:image" />}
    <slot name="head" />
    <style is:global>
      :root {
        color-scheme: light;
      }
      .dark {
        color-scheme: dark;
      }
    </style>
    <script is:inline>
      (function () {
        const applyTheme = () => {
          const storedTheme = localStorage.getItem('collegium-theme');
          const isDarkMode = storedTheme ? storedTheme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', isDarkMode);
        };
        applyTheme();
        if (!window.collegiumThemeListenerBound) {
          window.collegiumThemeListenerBound = true;
          document.addEventListener('astro:after-swap', applyTheme);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body
    class={cn('flex min-h-screen flex-col', className)}
    transition:persist
    transition:animate="none"
    transition:name="page-layout"
  >
    <slot />
  </body>
</html>
