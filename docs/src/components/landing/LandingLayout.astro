---
import '@/styles/landing.css';

import { Font } from 'astro:assets';

import Layout from '@/components/common/Layout.astro';

import Logo from '@/assets/logo.svg';

type NavLink = {
  external?: boolean;
  href: string;
  label: string;
};

interface Props {
  brand: string;
  description: string;
  footerLinks: NavLink[];
  headerLinks: NavLink[];
  title: string;
}

const { brand, description, footerLinks, headerLinks, title } = Astro.props;
---

<Layout class="bg-lp-background text-lp-text font-lp-sans" description={description} title={title}>
  <Font cssVariable="--font-geist" preload slot="head" />
  <Font cssVariable="--font-geist-mono" slot="head" />
  <Font cssVariable="--font-newsreader" preload slot="head" />
  <div class="flex flex-1 flex-col">
    <header class="border-lp-border bg-lp-background/80 fixed inset-x-0 top-0 z-50 border-b backdrop-blur">
      <div class="mx-auto flex h-14 w-full max-w-5xl items-center gap-6 px-6">
        <a class="flex items-center gap-2.5 text-sm font-medium" href="/">
          <Logo class="size-5" />
          {brand}
        </a>
        <nav class="text-lp-muted ml-auto flex items-center gap-5 text-sm">
          {
            headerLinks.map((link) => (
              <a
                class="hover:text-lp-text transition-colors"
                href={link.href}
                rel={link.external ? 'noreferrer' : undefined}
                target={link.external ? '_blank' : undefined}
              >
                {link.label}
              </a>
            ))
          }
          <button
            aria-label="Toggle colour theme"
            class="hover:text-lp-text hover:border-lp-border rounded-md border border-transparent p-1.5 transition-colors"
            id="lp-theme-toggle"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="size-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              viewBox="0 0 24 24"
            >
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main class="mx-auto flex w-full max-w-5xl flex-1 flex-col gap-24 px-6 pt-14 pb-32">
      <slot />
    </main>
    <footer class="border-lp-border border-t">
      <div class="mx-auto flex w-full max-w-5xl flex-col items-center justify-between gap-4 px-6 py-8 sm:flex-row">
        <p class="text-sm font-medium">{brand}</p>
        <nav class="text-lp-muted flex items-center gap-5 text-sm">
          {
            footerLinks.map((link) => (
              <a
                class="hover:text-lp-text transition-colors"
                href={link.href}
                rel={link.external ? 'noreferrer' : undefined}
                target={link.external ? '_blank' : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </footer>
  </div>
</Layout>
<script>
  const bind = () => {
    document.getElementById('lp-theme-toggle')?.addEventListener('click', () => {
      const isDarkMode = !document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', isDarkMode);
      localStorage.setItem('collegium-theme', isDarkMode ? 'dark' : 'light');
    });
  };
  bind();
  document.addEventListener('astro:after-swap', bind);
</script>
<script>
  let revealObserver: IntersectionObserver | undefined;

  const bindReveals = () => {
    revealObserver?.disconnect();
    const targets = document.querySelectorAll('[data-reveal]');
    if (targets.length === 0) return;
    document.documentElement.classList.add('lp-io');
    const observer = new IntersectionObserver(
      (entries) => {
        const revealable = entries
          .filter((entry) => entry.isIntersecting || entry.boundingClientRect.bottom < 0)
          .sort((first, second) => first.boundingClientRect.top - second.boundingClientRect.top);
        revealable.forEach((entry, index) => {
          if (entry.target instanceof HTMLElement) {
            entry.target.style.setProperty('--lp-reveal-delay', `${Math.min(index, 4) * 80}ms`);
          }
          entry.target.classList.add('lp-revealed');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -15% 0px' }
    );
    revealObserver = observer;
    targets.forEach((target) => observer.observe(target));
  };

  bindReveals();
  document.addEventListener('astro:after-swap', bindReveals);
</script>
