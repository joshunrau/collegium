---
type Refusal = {
  cost: string;
  title: string;
  what: string;
};

interface Props {
  costLabel: string;
  heading: string;
  intro: string[];
  refusals: Refusal[];
}

const { costLabel, heading, intro, refusals } = Astro.props;
---

<section class="flex flex-col">
  <h2 class="font-lp-serif text-3xl tracking-tight text-balance" data-reveal>{heading}</h2>
  <div class="mt-6 flex max-w-2xl flex-col gap-4">
    {
      intro.map((paragraph) => (
        <p class="text-lp-muted leading-relaxed text-pretty" data-reveal>
          {paragraph}
        </p>
      ))
    }
  </div>
  <ul class="mt-14 flex flex-col">
    {
      refusals.map((refusal) => (
        <li class="lp-hairline grid gap-x-10 gap-y-5 py-8 last:pb-0 md:grid-cols-2" data-reveal>
          <div class="flex flex-col gap-2">
            <h3 class="font-lp-serif text-xl tracking-tight text-balance">{refusal.title}</h3>
            <p class="text-lp-muted text-sm leading-relaxed text-pretty">{refusal.what}</p>
          </div>
          <div class="border-lp-accent/40 flex flex-col gap-2 self-start border-l pl-5">
            <span class="text-lp-muted font-lp-mono text-xs tracking-widest uppercase">{costLabel}</span>
            <p class="font-lp-serif text-lp-muted leading-relaxed text-pretty italic">{refusal.cost}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
