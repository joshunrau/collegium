---
import type { TranscriptAuthor, TranscriptAuthorProfile, TranscriptTurn } from '@/components/landing/MessageCard.astro';

import MessageCard from '@/components/landing/MessageCard.astro';

interface Props {
  authors: { [K in TranscriptAuthor]: TranscriptAuthorProfile };
  id: string;
  intro: string;
  kicker: string;
  outro: string;
  turns: TranscriptTurn[];
}

const { authors, id, intro, kicker, outro, turns } = Astro.props;
---

<section class="flex scroll-mt-20 flex-col gap-8" id={id}>
  <div class="flex flex-col gap-2">
    <h2 class="text-lp-muted font-lp-mono text-xs tracking-widest uppercase">{kicker}</h2>
    <p class="text-lp-muted max-w-2xl leading-relaxed">{intro}</p>
  </div>
  <div class="flex flex-col gap-3">
    {turns.map((turn) => <MessageCard author={authors[turn.author]} turn={turn} />)}
  </div>
  <p class="text-lp-muted max-w-2xl text-sm leading-relaxed">{outro}</p>
</section>
