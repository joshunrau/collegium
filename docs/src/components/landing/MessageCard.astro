---
import type { ImageMetadata } from 'astro';

import { Image } from 'astro:assets';

export type TranscriptAuthor = 'clara' | 'orchestrator' | 'theo';

export type TranscriptAuthorProfile = {
  avatar: ImageMetadata;
  name: string;
};

type TranscriptTurnBase = {
  at: string;
  author: TranscriptAuthor;
};

export type TranscriptTurn =
  | (TranscriptTurnBase & {
      approval: {
        approvedAt: string;
        approvedBy: string;
        paragraphs: string[];
        subject: string;
        to: string;
      };
      kind: 'approval';
    })
  | (TranscriptTurnBase & {
      kind: 'mail';
      mail: {
        body: string;
        from: string;
        subject: string;
      };
      text: string;
    })
  | (TranscriptTurnBase & {
      kind: 'text';
      text: string;
    })
  | (TranscriptTurnBase & {
      kind: 'tools';
      tools: {
        detail: string;
        tool: string;
      }[];
    });

interface Props {
  author: TranscriptAuthorProfile;
  turn: TranscriptTurn;
}

const { author, turn } = Astro.props;

const splitMentions = (text: string): { isMention: boolean; value: string }[] =>
  text
    .split(/((?<=^|\s)@[a-z]+)/g)
    .filter((value) => value.length > 0)
    .map((value) => ({ isMention: value.startsWith('@'), value }));
---

<article class="border-lp-border bg-lp-surface flex gap-3 rounded-xl border p-5">
  <Image
    alt=""
    class="size-8 shrink-0 rounded-md object-cover"
    densities={[1, 2]}
    height={32}
    src={author.avatar}
    width={32}
  />
  <div class="flex min-w-0 flex-1 flex-col gap-2">
    <p class="flex items-baseline gap-2">
      <span class="text-sm font-medium">{author.name}</span>
      <span class="text-lp-muted font-lp-mono text-xs">{turn.at}</span>
    </p>

    {
      (turn.kind === 'text' || turn.kind === 'mail') && (
        <p class="text-sm leading-relaxed">
          {splitMentions(turn.text).map((run) =>
            run.isMention ? (
              <span class="bg-lp-accent/12 text-lp-accent rounded px-1 py-0.5 font-medium">{run.value}</span>
            ) : (
              <span>{run.value}</span>
            )
          )}
        </p>
      )
    }

    {
      turn.kind === 'tools' && (
        <ul class="border-lp-border flex flex-col gap-1.5 border-l pl-3">
          {turn.tools.map((line) => (
            <li class="flex flex-wrap items-baseline gap-x-2 text-xs">
              <code class="font-lp-mono text-lp-text">{line.tool}</code>
              <span class="text-lp-muted">{line.detail}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      turn.kind === 'mail' && (
        <div class="border-lp-border bg-lp-panel rounded-lg border">
          <dl class="border-lp-border grid gap-1 border-b px-4 py-3 sm:grid-cols-[4rem_1fr]">
            <dt class="text-lp-muted font-lp-mono text-xs">From</dt>
            <dd class="text-sm">{turn.mail.from}</dd>
            <dt class="text-lp-muted font-lp-mono text-xs">Subject</dt>
            <dd class="text-sm">{turn.mail.subject}</dd>
          </dl>
          <p class="text-lp-muted px-4 py-3 text-sm leading-relaxed">{turn.mail.body}</p>
        </div>
      )
    }

    {
      turn.kind === 'approval' && (
        <div class="border-lp-accent/40 bg-lp-panel overflow-hidden rounded-lg border">
          <p class="border-lp-accent/25 text-lp-accent bg-lp-accent/8 font-lp-mono border-b px-4 py-2.5 text-xs tracking-wide">
            approval required · send mail
          </p>
          <dl class="border-lp-border grid gap-1 border-b px-4 py-3 sm:grid-cols-[4rem_1fr]">
            <dt class="text-lp-muted font-lp-mono text-xs">To</dt>
            <dd class="text-sm">{turn.approval.to}</dd>
            <dt class="text-lp-muted font-lp-mono text-xs">Subject</dt>
            <dd class="text-sm">{turn.approval.subject}</dd>
          </dl>
          <div class="flex flex-col gap-3 px-4 py-3 text-sm leading-relaxed">
            {turn.approval.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <div class="border-lp-border flex flex-wrap items-center gap-2 border-t px-4 py-3">
            <span class="bg-lp-accent text-lp-accent-foreground rounded-md px-3 py-1.5 text-xs font-medium">
              Approve
            </span>
            <span class="border-lp-border rounded-md border px-3 py-1.5 text-xs font-medium">Deny</span>
            <span class="text-lp-muted font-lp-mono text-xs sm:ml-auto">
              Approved by {turn.approval.approvedBy} · {turn.approval.approvedAt}
            </span>
          </div>
        </div>
      )
    }
  </div>
</article>
