---
type Cta = {
  href: string;
  label: string;
};

interface Props {
  body: string;
  heading: string;
  primaryCta: Cta;
  secondaryCta: Cta;
}

const { body, heading, primaryCta, secondaryCta } = Astro.props;
---

<section class="flex min-h-[calc(100vh-3.5rem)] flex-col items-center justify-center">
  <div class="flex flex-col gap-6">
    <h1 class="font-lp-serif text-5xl leading-[1.08] tracking-tight text-balance sm:text-6xl">{heading}</h1>
    <p class="text-lp-muted max-w-xl leading-relaxed sm:text-lg">{body}</p>
    <div class="flex flex-wrap gap-3">
      <a
        class="bg-lp-text text-lp-background rounded-lg px-5 py-2.5 text-sm font-medium transition-opacity hover:opacity-90"
        href={primaryCta.href}
      >
        {primaryCta.label}
      </a>
      <a
        class="border-lp-border hover:bg-lp-surface rounded-lg border px-5 py-2.5 text-sm font-medium transition-colors"
        href={secondaryCta.href}
      >
        {secondaryCta.label}
      </a>
    </div>
  </div>
</section>
