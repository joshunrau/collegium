---
import '@/styles/globals.css';

import { ClientRouter } from 'astro:transitions';

interface Props {
  description: string;
  /** Site-root-relative path to the OpenGraph image, if the page has one. */
  image?: string;
  title: string;
}

const { description, image, title } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href={canonical} rel="canonical" />
    <title>{title}</title>
    <meta content={title} name="title" />
    <meta content={title} property="og:title" />
    <meta content={canonical} property="og:url" />
    <meta content="website" property="og:type" />
    <meta content={description} name="description" />
    <meta content={description} property="og:description" />
    {image && <meta content={new URL(image, Astro.site)} property="og:image" />}
    <slot name="head" />
    <script is:inline>
      // The chosen theme must reach `<html>` before first paint, and again after every client-side
      // navigation: Astro's swap wipes every attribute off `<html>`, this class included.
      (() => {
        const apply = () => {
          const stored = localStorage.getItem('collegium-theme');
          const dark = stored === 'dark' || (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
        };
        apply();
        if (!window.collegiumThemeListenerBound) {
          window.collegiumThemeListenerBound = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col" transition:persist transition:animate="none" transition:name="page-layout">
    <slot />
  </body>
</html>
