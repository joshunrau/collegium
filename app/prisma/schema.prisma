datasource db {
  provider = "sqlite"
}

generator client {
  provider            = "prisma-client"
  output              = "../src/prisma/generated"
  importFileExtension = "ts"
}

generator json {
  provider  = "prisma-json-types-generator"
  namespace = "PrismaJson"
}

/// §8.3 — what started a turn: a post addressing an idle agent, its queue drained as its own turn
/// ended, a colleague's turn that addressed it ending or parking (§5.2), a trigger announced (§4.2),
/// posts a reconnect recovered, or the boot or /collegium resume sweep of a standing queue (§7.3)
enum ActivationKind {
  addressed
  drain
  handoff
  resync
  sweep
  trigger
}

enum ApprovalStatus {
  approved
  denied
  denied_with_reason
  invalidated
  pending
}

enum AskStatus {
  answered
  invalidated
  pending
}

enum AuthorKind {
  agent
  human
  system
}

/// what a post is to the agent whose turn authored it; `message` is every post observed rather than authored,
/// and `prompt` an approval or ask prompt the turn parked on, which addresses no colleague (§4.5)
enum PostKind {
  message
  notice
  prompt
  reply
  status
}

enum TriggerSource {
  cron
  mail
  webhook
}

enum TriggerStatus {
  pending
  posted
  resolved
}

enum TurnEventKind {
  approval_decided
  approval_requested
  ask_answered
  ask_requested
  assistant_message
  output_rejected
  record_written
  steering_received
  tool_result
}

enum WorkUnitState {
  assigned
  blocked
  review
  done
  cancelled
}

enum TurnStatus {
  abandoned
  budget_exhausted
  completed
  context_exhausted
  denied
  halted
  killed
  provider_outage
  provider_rejected
  delivery_failure
  running
  semantic_error
  side_effect_ambiguous
  stopped
}

// Mattermost owns post ids and decides when a post is observed, so a column naming a post is a
// plain string: the row it refers to may not have been recorded yet. Columns naming a turn are
// foreign keys, because the framework creates the turn before anything can reference it.

model Post {
  id              String     @id
  /// [PostAttachments]
  attachments     Json?
  authorKind      AuthorKind
  authorUsername  String
  channelId       String
  createdAt       DateTime
  isForgotten     Boolean    @default(false)
  /// §3.8 — pinned in Mattermost now; the one state of a post the store follows after recording it (§8.2)
  isPinned        Boolean    @default(false)
  kind            PostKind   @default(message)
  message         String
  observedAt      DateTime   @default(now())
  authoringTurnId String?
  authoringTurn   Turn?      @relation(fields: [authoringTurnId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
  @@index([channelId, isPinned])
}

model Turn {
  id               String      @id @default(cuid(2))
  actionCount      Int         @default(0)
  /// §8.3 — null on turns recorded before the column existed
  activationKind   ActivationKind?
  agentUsername      String
  cachedPromptTokens Int?
  chainLength        Int         @default(1)
  channelId          String
  completionTokens   Int?
  /// §8.3 — when the context the turn last used was assembled; a fold (§4.4) assembles it again
  contextAssembledAt DateTime?
  /// what the provider charged for this turn, in USD, summed over its completions; null where the
  /// provider prices nothing in its response
  costUsd            Float?
  depth            Int
  /// §5.2 — the earliest queued post of the queue entry the turn took over, drained or absorbed at
  /// its start; null where it took none, and after a /collegium clear (§8.5), which removes every
  /// post it named
  drainedFromPostId String?
  endedAt          DateTime?
  modelName        String
  promptTokens     Int?
  reasoningTokens  Int?
  /// §7.4 — the human or trigger post this chain descends from; every turn in one chain carries the
  /// same one, so the limit is a count over the chain rather than a hop count along one path. Null
  /// for turns recorded before the column existed, which are their own root, and null again after a
  /// /collegium clear (§8.5), which keeps the row and removes every post it named.
  rootPostId       String?
  startedAt        DateTime    @default(now())
  status           TurnStatus
  statusPostId     String?
  triggeringPostId String?
  /// §8.3 — the window of that assembly: its oldest entry, null for an empty window, and what the
  /// budget charged for it (§3.8)
  windowEstimatedTokens Int?
  windowOldestAt   DateTime?
  approvals        Approval[]
  asks             Ask[]
  authoredPosts    Post[]
  events           TurnEvent[]

  @@index([agentUsername, channelId, startedAt])
  @@index([rootPostId])
  @@index([startedAt])
  @@index([status])
}

// The §7.4 rolling window's lower bound: when a human last cleared a ceiling halt. The count itself
// is the Turn table's, so the window survives a restart and a crash-looping instance cannot grant
// itself a fresh allowance every boot; this row only says where the trailing hour starts counting
// from, which is what `/resume` advances. One row, pinned by a constant key.
// §3.15 — one thing one agent handed to another, in one channel. Every state it has been in was
// announced in a post, and the row names the post that created it and the post that last changed
// it, which is what keeps it a control state pointing at posts (A1) rather than work held nowhere
// else. The row is written only after that post has landed, so neither id is ever null. There is
// no unassigned state: a unit exists because someone handed it over.
model WorkUnit {
  id               String        @id @default(cuid(2))
  assigneeUsername String
  channelId        String
  closedAt         DateTime?
  /// §3.15 — who closed it: the creator, or a person cancelling on their own authority (§8.4); null
  /// while open, and on a unit closed before the column existed
  closedByUsername String?
  context          String
  createdAt        DateTime      @default(now())
  creatorUsername  String
  criteria         String
  /// §3.15 — the unit this one continues, closed as done by the post that assigned this one; null for
  /// a fresh hand-off. Not a relation: §8.5 may erase the earlier unit and leave this one standing
  followsId        String?
  lastPostId       String
  originPostId     String
  outcome          String
  state            WorkUnitState
  updatedAt        DateTime      @updatedAt
  /// §3.15 — the creator's judgement on closing; a person's cancellation carries none
  verdict          String?

  @@index([channelId, state])
  @@index([channelId, creatorUsername])
  @@index([channelId, assigneeUsername])
}

model ResumeWatermark {
  key       String   @id
  resumedAt DateTime
}

// §7.3 — the downtime window is measured against the process, so the process records itself: a
// periodic stamp bounds a crash and a stop time makes a clean shutdown exact. One row, pinned by a
// constant id.
model Runtime {
  id          String    @id
  lastAliveAt DateTime
  stoppedAt   DateTime?
}

model TurnEvent {
  id        String        @id @default(cuid(2))
  createdAt DateTime      @default(now())
  kind      TurnEventKind
  /// [TurnEventPayload]
  payload   Json
  sequence  Int
  turnId    String
  turn      Turn          @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, sequence])
}

model Approval {
  id                String         @id @default(cuid(2))
  /// [ApprovalArgs]
  args              Json
  createdAt         DateTime       @default(now())
  decidedAt         DateTime?
  decidedByUsername String?
  payloadText       String
  promptPostId      String?
  reason            String?
  status            ApprovalStatus
  // the two segments of a tool identity, stored structurally (§10); a null namespace is a
  // framework action that is not a tool, e.g. the budget extension
  toolName          String
  toolNamespace     String?
  turnId            String
  turn              Turn           @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([status])
}

// §3.7a — a question put to the channel rather than a consent decision, so no row here records a
// refusal: an ask ends answered, or invalidated by whatever cancels a pending approval.
model Ask {
  id                 String    @id @default(cuid(2))
  answerText         String?
  answeredAt         DateTime?
  answeredByUsername String?
  createdAt          DateTime  @default(now())
  /// [AskOptions]
  options            Json?
  promptPostId       String?
  question           String
  status             AskStatus
  toolName           String
  toolNamespace      String
  turnId             String
  turn               Turn      @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Trigger {
  id                  String        @id @default(cuid(2))
  createdAt           DateTime      @default(now())
  // exactly-once intake: an adapter that can re-observe the same event (mail, after a crash
  // between recording and cursor advance) supplies a stable key, and a duplicate is a no-op
  dedupeKey           String?       @unique
  postId              String?
  postedAt            DateTime?
  /// [TriggerReference]
  reference           Json
  resolvedAt          DateTime?
  source              TriggerSource
  status              TriggerStatus
  targetAgentUsername String
  targetChannelId     String

  @@index([targetAgentUsername, status])
  @@index([targetChannelId, status])
}

// One row per agent mailbox: where inbound polling has read to. Created at first connection
// without announcing existing mail; the serialization is the provider adapter's own, and
// nothing else parses it.
/// §4.2 — the occurrence a declared schedule last announced. State, not a declaration: the row
/// appears when its declaration first does and is deleted when the declaration goes, so config stays
/// the only place a schedule is defined.
model ScheduleState {
  id           String    @id
  firstSeenAt  DateTime  @default(now())
  lastFiredFor DateTime?
}

model MailCursor {
  id            String   @id @default(cuid(2))
  agentUsername String   @unique
  cursor        String
  updatedAt     DateTime @updatedAt
}

model QueueEntry {
  id                        String   @id @default(cuid(2))
  agentUsername             String
  channelId                 String
  createdAt                 DateTime @default(now())
  earliestUnprocessedPostId String
  lastEnqueuedAt            DateTime

  @@unique([agentUsername, channelId])
}

model ToolsetRecord {
  id         String
  collection String
  createdAt  DateTime @default(now())
  namespace  String
  /// [ToolsetRecordPayload]
  payload    Json
  updatedAt  DateTime @updatedAt

  @@id([namespace, collection, id])
}

model Memory {
  id            String    @id @default(cuid(2))
  agentUsername String
  body          String
  createdAt     DateTime  @default(now())
  description   String
  /// §3.6 — when this entry's body was last read, by the agent or by a person, or revised; its write
  /// time until then. What eviction orders by, so the entry nobody has needed goes before yesterday's note.
  lastUsedAt    DateTime  @default(now())
  originPostId  String?
  /// §3.6 — when the body was last revised in place; null for an entry never revised
  revisedAt     DateTime?
  /// §3.6 — how many times the body has been revised in place. What a turn's delete compares with
  /// the revision that turn last saw.
  revision      Int       @default(0)

  @@index([agentUsername, createdAt])
  @@index([agentUsername, lastUsedAt])
  @@index([originPostId])
}

model Episode {
  id            String   @id @default(cuid(2))
  agentUsername String
  channelId     String
  createdAt     DateTime @default(now())
  postId        String

  @@index([agentUsername, channelId, createdAt])
}

/// §8.5 — the instant, on Mattermost's clock, a channel's last clear erased every post before. A post
/// that old is never recorded again: one the chat server still shows is one its deletion missed.
model ChannelClear {
  channelId    String   @id
  erasedBefore DateTime
}

/// A Mattermost access token the provisioner minted, keyed by the account it belongs to. Mattermost
/// reveals a token once and never again, so losing this row means minting a replacement and
/// orphaning the last one.
model MattermostCredential {
  username  String   @id
  createdAt DateTime @default(now())
  token     String
  userId    String
}
