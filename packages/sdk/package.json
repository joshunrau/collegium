{
  "name": "@collegium/sdk",
  "type": "module",
  "version": "0.0.1-beta.6",
  "description": "Write a Collegium plugin: declare a toolset with its tools, settings, storage, and skills.",
  "license": "AGPL-3.0-only",
  "homepage": "https://collegium.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshunrau/collegium.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "collegium",
    "plugin",
    "toolset",
    "agent"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "lint": "tsc && eslint --fix ."
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "dependencies": {
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@collegium/core": "workspace:*",
    "tsdown": "^0.22.14",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
