{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "app": {
      "entry": ["src/main.ts!", "src/entrypoint.ts!", "scripts/schema.ts"],
      "project": ["src/**/*.ts!"],
      "ignore": ["src/prisma/generated/**", "src/testing/**"],
      "ignoreDependencies": ["@prisma/client", "prisma"]
    },
    "docs": {
      "entry": ["astro.config.js", "src/content.config.ts"],
      "project": ["src/**/*.{ts,js,astro}"]
    },
    "packages/core": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/sdk": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!"]
    }
  }
}
