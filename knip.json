{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.js"],
      "project": ["scripts/*.js"]
    },
    "app": {
      "entry": ["src/main.ts!", "src/entrypoint.ts!", "src/provision.ts!"],
      "project": ["src/**/*.ts!"],
      "ignore": ["src/prisma/generated/**", "src/testing/**"],
      "ignoreDependencies": ["@prisma/client", "prisma"]
    },
    "docs": {
      "entry": ["src/pages/**/*.{ts,astro}!", "src/reference/reference.loader.ts!"],
      "project": ["src/**/*.{ts,tsx,js,astro}!"]
    },
    "packages/config": {
      "entry": ["src/index.ts!", "scripts/build-schema.ts"],
      "project": ["src/**/*.ts!"]
    },
    "packages/core": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!"]
    },
    "packages/sdk": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!"]
    }
  }
}
