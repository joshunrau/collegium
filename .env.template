# Every variable is described at https://collegium.sh/docs/reference/environment

# `bundled` starts a Mattermost beside the app; clear it to use a server you already run.
COMPOSE_PROFILES=bundled

APP_BIND_HOST=127.0.0.1
APP_PORT=3000
CONFIG_PATH=./config.json
MATTERMOST_TEAM=collegium
PLUGINS_ROOT=./plugins
RESOURCES_ROOT=./resources

# ------------------------------------------
# THE BUNDLED MATTERMOST
# ------------------------------------------

# https://collegium.sh/docs/introduction/quickstart

MATTERMOST_ADMIN_EMAIL=admin@collegium.local
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_ADMIN_USERNAME=
MATTERMOST_PORT=8065
MATTERMOST_PUBLIC_URL=
POSTGRES_PASSWORD=postgres

# ------------------------------------------
# A MATTERMOST YOU ALREADY RUN
# ------------------------------------------

# https://collegium.sh/docs/guides/use-an-existing-mattermost

# APP_PUBLIC_URL=https://collegium.example.org:3000
# MATTERMOST_ADMIN_TOKEN=
# MATTERMOST_LOCAL_URL=https://mattermost.example.org
