# Where the app is published on the host, on the loopback.
APP_PORT=3000

# Path to config.json on the host.
CONFIG_PATH=./config.json

# The Mattermost administrator. On a first start this account is created; afterwards it is signed
# in with. This is also how you log in to Mattermost yourself.
MATTERMOST_ADMIN_EMAIL=admin@collegium.local
MATTERMOST_ADMIN_USERNAME=
MATTERMOST_ADMIN_PASSWORD=

# Where Mattermost is published on the host, on the loopback.
MATTERMOST_PORT=8065

# The team, by handle — the name in its URL. Created if absent.
MATTERMOST_TEAM=collegium

# Directory holding one plugin per subdirectory, each named for the plugin it holds. Mounted
# read-only; a clone already has this directory.
PLUGINS_ROOT=./plugins

# Password for the Postgres that serves Mattermost, which is reachable only from the compose
# network. Change it if you publish that port.
POSTGRES_PASSWORD=postgres
