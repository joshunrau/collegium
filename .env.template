# The interface the app binds to. The decision, command, and trigger endpoints trust the network, so
# bind the loopback or a private interface that only the Mattermost server can reach. The container
# runs on the host's own network, so this is also the address Mattermost calls back on — which is
# why APP_PUBLIC_URL is never stated.
APP_HOST=127.0.0.1

# The port the app listens on.
APP_PORT=3000

# Base URL of the Mattermost server. Its scheme must be http or https: the websocket address is this
# one with the scheme rewritten, so anything else yields a transport that can never connect.
MATTERMOST_URL=

# The team this deployment occupies, by handle — the name in its URL, not its display name. Every
# channel handle in config.json resolves within it, and the slash-command surface belongs to it.
MATTERMOST_TEAM=

# Path to config.json, resolved against the working directory. The deployment mounts this file into
# the container, which reads it at a fixed path of its own. `pnpm dev` runs from app/ and pins this
# to ../config.json itself, so this value serves the deployment alone.
CONFIG_PATH=./config.json

# Development only: the deployment's database is a fact of the image's filesystem, stated in
# docker-compose.yaml. As an absolute file URL naming no host, e.g. file:///path/to/repo/data/dev.db
# (the parent directory is created on demand). Prisma's own relative form, file:./dev.db, is refused:
# it normalizes to a path directly beneath the filesystem root, which the container entrypoint would
# then take for the state directory and chown recursively.
DATABASE_URL=
