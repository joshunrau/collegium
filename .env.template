# The Mattermost this stack runs against. `bundled` starts one here, beside the app; clear this
# line to integrate with a server you already run, and set MATTERMOST_URL and APP_PUBLIC_URL below.
COMPOSE_PROFILES=bundled

# Where the app is published, and on which interface. The loopback is enough for a bundled
# Mattermost, which reaches the app over the Compose network; a server elsewhere needs an address
# that reaches this host, so widen this to 0.0.0.0 or to the interface that server can call.
APP_BIND_HOST=127.0.0.1
APP_PORT=3000

# Path to config.json on the host.
CONFIG_PATH=./config.json

# The team, by handle — the name in its URL. Created if absent.
MATTERMOST_TEAM=collegium

# Directory holding one plugin per subdirectory, each named for the plugin it holds. Mounted
# read-only; a clone already has this directory.
PLUGINS_ROOT=./plugins

# --- The bundled Mattermost -------------------------------------------------------------------
# Read only while COMPOSE_PROFILES names `bundled`.

# The administrator. On a first start this account is created; afterwards it is signed in with.
# This is also how you log in to Mattermost yourself.
MATTERMOST_ADMIN_EMAIL=admin@collegium.local
MATTERMOST_ADMIN_USERNAME=
MATTERMOST_ADMIN_PASSWORD=

# Where Mattermost is published on the host, on the loopback.
MATTERMOST_PORT=8065

# Password for the Postgres that serves Mattermost, which is reachable only from the compose
# network. Change it if you publish that port.
POSTGRES_PASSWORD=postgres

# --- A Mattermost you already run -------------------------------------------------------------
# Clear COMPOSE_PROFILES above, then set all three. The administrator is named by a personal access
# token instead of a password: it creates no account on your server, and an administrator with MFA
# enabled has no other way to authenticate over the API. Leave the three variables above unset.
#
# Your server must also permit bot accounts and personal access tokens, and must list the host of
# APP_PUBLIC_URL under AllowedUntrustedInternalConnections when that address is private — boot
# refuses and names any of these it finds missing.

# MATTERMOST_URL=https://mattermost.example.org
# APP_PUBLIC_URL=https://collegium.example.org:3000
# MATTERMOST_ADMIN_TOKEN=
