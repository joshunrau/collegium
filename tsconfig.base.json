{
  "extends": ["@douglasneuroinformatics/tsconfig"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "maxNodeModuleJsDepth": 0,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "types": ["node"]
  }
}
