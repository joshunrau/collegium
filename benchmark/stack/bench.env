# Local-only values for the benchmark stack. Every port binds the loopback and the Mattermost is
# thrown away with ./state between runs, so none of these is a secret. Provider keys and the bench
# mailbox never live here: render-config.js reads them from the shell environment.
APP_PORT=3001
CALLBACK_TOKEN=bench-callback-token-0123456789abcdef0123456789
TRIGGER_TOKEN=bench-trigger-token-0123456789abcdef0123456789
MATTERMOST_ADMIN_EMAIL=admin@bench.local
MATTERMOST_ADMIN_PASSWORD=Bench-admin-2026
MATTERMOST_ADMIN_USERNAME=bench-admin
MATTERMOST_PORT=8066
MATTERMOST_TEAM=bench
POSTGRES_PASSWORD=bench
